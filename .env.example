# Copy to .env and fill in. Never commit .env.
# All variables use the SCHEMEBOT_ prefix (see src/schemebot/config.py).

# LLM
SCHEMEBOT_ANTHROPIC_API_KEY=
SCHEMEBOT_LLM_MODEL=claude-sonnet-5-5

# Models
SCHEMEBOT_EMBEDDING_MODEL=BAAI/bge-m3
SCHEMEBOT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector store
SCHEMEBOT_QDRANT_URL=http://localhost:6333
SCHEMEBOT_QDRANT_COLLECTION=schemes

# Retrieval and refusal
SCHEMEBOT_RETRIEVAL_TOP_K=20
SCHEMEBOT_RERANK_TOP_K=5
SCHEMEBOT_REFUSAL_THRESHOLD=0.35

# OCR. Windows: tesseract.exe is not on PATH after install, so give the full path.
# TESSDATA_DIR is only needed if the tam/hin models live outside the install folder.
SCHEMEBOT_TESSERACT_CMD=
SCHEMEBOT_TESSDATA_DIR=
