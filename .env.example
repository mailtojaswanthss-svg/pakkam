# Copy to .env and fill in. Never commit .env.
# All variables use the SCHEMEBOT_ prefix (see src/schemebot/config.py).

# Which LLM writes and checks answers: claude or gemini
SCHEMEBOT_LLM_PROVIDER=claude

# Claude (leave the key empty to use ANTHROPIC_API_KEY or an `ant auth login` profile)
SCHEMEBOT_ANTHROPIC_API_KEY=
SCHEMEBOT_LLM_MODEL=claude-opus-5-5
SCHEMEBOT_LLM_EFFORT=medium
SCHEMEBOT_VERIFY_ANSWERS=true
# Per LLM call: seconds per attempt, and retries on rate limits / server errors.
# For a long evaluation run on the Gemini free tier, use 7 retries.
SCHEMEBOT_LLM_TIMEOUT_SECONDS=60
SCHEMEBOT_LLM_RETRIES=2
SCHEMEBOT_VERIFIER_MODEL=claude-haiku-5-5

# Gemini (needs `uv sync --extra gemini`; an empty key falls back to GEMINI_API_KEY)
SCHEMEBOT_GEMINI_API_KEY=
SCHEMEBOT_GEMINI_MODEL=gemini-3.8-flash
SCHEMEBOT_GEMINI_VERIFIER_MODEL=gemini-3.5-flash-lite
SCHEMEBOT_GEMINI_JUDGE_MODEL=gemini-3.6-flash

# Models
SCHEMEBOT_EMBEDDING_MODEL=BAAI/bge-m3
SCHEMEBOT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector store (Qdrant local mode, stored in data/index/)
SCHEMEBOT_QDRANT_COLLECTION=schemes
SCHEMEBOT_EMBED_BATCH_SIZE=16

# Retrieval and refusal
SCHEMEBOT_RETRIEVAL_TOP_K=20
SCHEMEBOT_RERANK_TOP_K=5
SCHEMEBOT_REFUSAL_THRESHOLD=0.35
# The reranker also reads an English gloss of Tanglish words (retrieve/tanglish.py)
SCHEMEBOT_GLOSS_TANGLISH=true

# Public demo limits on POST /ask: per visitor per minute, and in total per day
SCHEMEBOT_ASK_LIMIT_PER_CLIENT_PER_MINUTE=10
SCHEMEBOT_ASK_LIMIT_TOTAL_PER_DAY=500

# Gnani voice input (Prisma v2.5 speech to text). Get the key from app.gnani.ai/voice.
SCHEMEBOT_GNANI_API_KEY=
SCHEMEBOT_STT_MAX_SECONDS=30
# Daily cap on Gnani calls (web app + compare script together; failed calls count too).
# The count is kept in logs/gnani-calls.json and resets at midnight IST.
SCHEMEBOT_GNANI_MAX_CALLS_PER_DAY=100

# Gnani Timbre text to speech (spoken answers). Off until you choose the model:
# timbre-v2.5 or timbre-v3.0 (check which one your dashboard offers). Voices are optional;
# empty uses the default for the model (src/schemebot/voice/tts.py). Every spoken answer
# counts against SCHEMEBOT_GNANI_MAX_CALLS_PER_DAY.
SCHEMEBOT_TTS_MODEL=
SCHEMEBOT_TTS_VOICE_TA=
SCHEMEBOT_TTS_VOICE_HI=
SCHEMEBOT_TTS_VOICE_EN=
# Say money amounts as words ("Rs. 1,000" -> "ஆயிரம் ரூபாய்") before speaking. Off until the
# listening test shows it is needed. Check the corpus first: python -m schemebot.voice amounts
SCHEMEBOT_TTS_SPELL_AMOUNTS=false

# OCR. Windows: tesseract.exe is not on PATH after install, so give the full path.
# TESSDATA_DIR is only needed if the tam/hin models live outside the install folder.
SCHEMEBOT_TESSERACT_CMD=
SCHEMEBOT_TESSDATA_DIR=
