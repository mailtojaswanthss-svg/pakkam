# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data: raw documents are re-downloadable from docs/data_sources.md;
# processed chunks are rebuilt by the ingestion script. The eval set is committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs and model caches
logs/
*.log
.cache/
qdrant_storage/
*-calls.json
*.lock

# Search index (rebuilt by python -m schemebot.index)
data/index/

# Per-question evaluation runs (regenerated by python -m schemebot.evaluation)
data/eval/runs/

# Local helper binaries (cloudflared for the public tunnel)
tools/

# Voice recordings and their transcripts (python -m schemebot.voice): never committed
data/voice/
data/voice/field_clips/
data/voice/prisma_raw_sample.json

data/audio_cache/
*.wav
*.mp3

data/eval/answer_eval_raw/
