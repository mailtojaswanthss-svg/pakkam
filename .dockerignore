# Keep the build context small and secrets out of the image.
.env
.env.*
.git
.github
.claude
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
*.log

# Mounted at run time by compose. The Cloud Run target copies only data/index,
# data/sources.json and data/contacts.json, so everything else stays out.
data/raw
data/processed
data/eval
logs

# Not needed to run the app
docs
tests
